{
  "schemaVersion": 3,
  "zoneId": "11111111-1111-1111-1111-111111111111",
  "tenantId": "22222222-2222-2222-2222-222222222222",
  "hostname": "shop.example.com",
  "originAddress": "http://10.0.0.5:8080",
  "status": "active",
  "protectionMode": "enforce",
  "configVersion": 7,
  "ddos": [
    {
      "id": "d1",
      "sensitivity": "high",
      "action": "challenge",
      "requestRateThreshold": 500,
      "burstWindowSeconds": 10,
      "pathPrefix": "/login",
      "httpMethod": "POST",
      "priority": 1
    },
    {
      "id": "d2",
      "sensitivity": "low",
      "action": "block",
      "requestRateThreshold": 5000,
      "burstWindowSeconds": 60,
      "priority": 2
    }
  ],
  "rules": [
    {
      "id": "r1",
      "name": "always log",
      "ruleType": "custom",
      "action": "log",
      "priority": 10,
      "matchExpr": "always"
    },
    {
      "id": "r2",
      "name": "admin from outside",
      "ruleType": "custom",
      "action": "block",
      "priority": 20,
      "matchExpr": {
        "all": [
          {
            "predicate": {
              "field": "uriPath",
              "op": "startsWith",
              "value": "/admin"
            }
          },
          {
            "not": {
              "predicate": {
                "field": "sourceIpCidr",
                "op": "in",
                "values": [
                  "10.0.0.0/8",
                  "192.168.0.0/16"
                ]
              }
            }
          }
        ]
      }
    },
    {
      "id": "r3",
      "name": "scanners",
      "ruleType": "custom",
      "action": "challenge",
      "priority": 30,
      "matchExpr": {
        "any": [
          {
            "predicate": {
              "field": "userAgent",
              "op": "containsCi",
              "value": "sqlmap"
            }
          },
          {
            "predicate": {
              "field": "uriQuery",
              "op": "contains",
              "value": "union select"
            }
          },
          {
            "predicate": {
              "field": "uriQuery",
              "op": "notContains",
              "value": "safe=1"
            }
          },
          {
            "predicate": {
              "field": "uriPath",
              "op": "endsWith",
              "value": ".php"
            }
          },
          {
            "predicate": {
              "field": "uriPath",
              "op": "regex",
              "value": "^/wp-(admin|login)"
            }
          },
          {
            "predicate": {
              "field": "header",
              "op": "eq",
              "value": "1",
              "param": "x-debug"
            }
          },
          {
            "predicate": {
              "field": "method",
              "op": "notEq",
              "value": "GET"
            }
          },
          {
            "predicate": {
              "field": "sourceIp",
              "op": "eq",
              "value": "203.0.113.9"
            }
          },
          {
            "predicate": {
              "field": "country",
              "op": "notIn",
              "values": [
                "VN",
                "SG"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "r4",
      "name": "api rate limit",
      "ruleType": "rateLimit",
      "action": "allow",
      "priority": 40,
      "matchExpr": {
        "predicate": {
          "field": "uriPath",
          "op": "startsWith",
          "value": "/api"
        }
      },
      "rateLimit": {
        "threshold": 100,
        "windowSeconds": 60
      }
    }
  ],
  "compiledAt": "2026-11-07T00:00:00Z"
}
