# waf-config-distributor — copy to .env for local dev.

# --- management-plane (read config from, write telemetry to) ---
# Both point at the GraphQL gateway (`../management-plane/graphql-gateway`, port 4000), not at
# zones-service/alerting-service's own ports directly — found live 2026-09-27 wiring the first
# real control-plane -> edge-plane e2e proof: neither service mounts `/graphql` itself (each only
# exposes gRPC, `GRPC_ENABLED`, for the gateway to aggregate) — only the gateway aggregates all 3
# services' entities into one schema reachable over HTTP. See dataplane.rs's own module doc
# comment for the full story (this file used to call REST `/api/{entity}` directly against each
# service, removed by `metap` core 2026-09-21).
ZONES_URL=http://localhost:4000
CONTROL_LOGIN_URL=http://localhost:3000/auth/login
# A real user in the tenant this worker distributes config for. Create it with
# `cargo run --manifest-path ../../metap/crates/metap-dev-tools/Cargo.toml -- create-user <tenantId> ...`
# and give it read access to waf.zones / waf.ddos_policies / waf.firewall_rules.
# Not a hand-minted JWT: this logs in and refreshes in the background.
CONTROL_SERVICE_EMAIL=control-plane@example.com
CONTROL_SERVICE_PASSWORD=change-me

# --- analytics-plane (write telemetry to) ---
# Edge telemetry goes to analytics-api in batches, filed under the service account's tenant.
# ANALYTICS_INGEST_TOKEN must match analytics-api's own; leave empty only in local dev.
ANALYTICS_URL=http://localhost:3030
ANALYTICS_INGEST_TOKEN=

# --- distribution target (edge-plane reads these keys) ---
REDIS_URL=redis://localhost:6379

# --- change feed ---
AMQP_URL=amqp://guest:guest@localhost:5672/%2f
# Fixed name so replicas share one queue and compete for messages instead of each recompiling the
# same change.
CONFIG_DISTRIBUTOR_QUEUE=waf.config-distributor

# --- convergence ---
# The full sweep is what guarantees the edge is correct; the event feed is only the fast path.
RESYNC_INTERVAL_SECONDS=60

# --- telemetry ingest (edge-plane posts here) ---
HOST=0.0.0.0
PORT=4100
INGEST_MAX_BATCH=200
INGEST_MAX_REQUEST_EVENTS=1000
# Shared secret the edge must present as `X-WAF-Ingest-Token`. Leave unset in dev to disable the
# check; set it anywhere the ingest port is reachable by anything but your own edge nodes.
# INGEST_TOKEN=
