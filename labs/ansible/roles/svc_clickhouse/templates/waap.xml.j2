<!-- {{ ansible_managed }} -->
<clickhouse>
  <listen_host>{{ clickhouse_listen }}</listen_host>
  <listen_host>127.0.0.1</listen_host>
  <path>{{ clickhouse_data }}/</path>
  <tmp_path>{{ clickhouse_data }}/tmp/</tmp_path>
  <user_files_path>{{ clickhouse_data }}/user_files/</user_files_path>
  <timezone>UTC</timezone>
  <!-- 70% RAM cho server: chừa chỗ cho hệ điều hành và bộ nhớ đệm đĩa trên VM nhỏ (mặc định 90%). -->
  <max_server_memory_usage_to_ram_ratio>0.7</max_server_memory_usage_to_ram_ratio>
  <max_concurrent_queries>100</max_concurrent_queries>
  <logger><level>information</level><size>100M</size><count>5</count></logger>
</clickhouse>
