#!/bin/sh
# {{ ansible_managed }}
# Dùng: waap-loadgen <hostname-của-zone> [số-request]
# In mã trạng thái từng loại request để so với luật của zone (ví dụ rule chặn /admin hoặc XSS giả).
set -eu
host="${1:?hostname của zone}"; n="${2:-20}"
edge="{{ loadgen_edge_ip }}"
req() { curl -s -o /dev/null -w "%{http_code}" --max-time 5 -H "Host: $host" "$@" "http://$edge:8080$path"; }
for kind in normal admin xss; do
  case "$kind" in
    normal) path="/" ;;
    admin)  path="/admin" ;;
    xss)    path="/?q=%3Cscript%3Ealert(1)%3C/script%3E" ;;
  esac
  echo "$kind $(req)"
done
echo "burst $n requests:"
ab -q -n "$n" -c 5 -H "Host: $host" "http://$edge:8080/" 2>/dev/null | grep -E "Complete requests|Non-2xx" || true
