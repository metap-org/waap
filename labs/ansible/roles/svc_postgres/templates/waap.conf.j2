# {{ ansible_managed }}
listen_addresses = '127.0.0.1,{{ app_listen_ip }}'
ssl = on
ssl_min_protocol_version = 'TLSv1.2'
ssl_prefer_server_ciphers = on
ssl_cert_file = '/etc/ssl/certs/ssl-cert-snakeoil.pem'
ssl_key_file = '/etc/ssl/private/ssl-cert-snakeoil.key'
password_encryption = scram-sha-256
log_connections = on
log_disconnections = on
log_line_prefix = '%m [%p] %q%u@%d %h '
# Bộ nhớ: VM data-1 5 GiB dùng chung với Redis (256 MB) và RabbitMQ, nên shared_buffers ~10% chứ không 25%.
shared_buffers = 512MB
huge_pages = try
effective_cache_size = 2GB
work_mem = 4MB
maintenance_work_mem = 128MB
max_connections = 200
# SSD ảo: chi phí đọc ngẫu nhiên gần tuần tự, nhiều I/O đồng thời.
random_page_cost = 1.1
effective_io_concurrency = 200
# WAL và checkpoint
wal_compression = on
checkpoint_completion_target = 0.9
max_wal_size = 2GB
min_wal_size = 512MB
# Quan sát và chống treo
log_checkpoints = on
log_lock_waits = on
log_temp_files = 0
log_min_duration_statement = 500
track_io_timing = on
idle_in_transaction_session_timeout = 60000
tcp_keepalives_idle = 60
tcp_keepalives_interval = 10
tcp_keepalives_count = 6
