# {{ ansible_managed }}
bind 127.0.0.1 {{ app_listen_ip }}
protected-mode yes
port 6379
dir {{ redis_dir }}
appendonly yes
maxmemory {{ redis_maxmemory }}
maxmemory-policy noeviction
# Bộ luật là cấu hình, không phải cache: không được bị loại bỏ (control-plane README).
user default off
user control on >{{ redis_control_password }} ~waf:* +@all -@dangerous +ping
user edge on >{{ redis_edge_password }} ~waf:* -@all +@read +ping +info
# Lệnh nguy hiểm bị chặn bằng ACL (-@dangerous); rename-command đã bị khuyến cáo bỏ.
tcp-backlog 511
tcp-keepalive 300
maxclients 10000
appendfsync everysec
aof-use-rdb-preamble yes
lazyfree-lazy-eviction yes
lazyfree-lazy-expire yes
acllog-max-len 128
