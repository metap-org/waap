#!/usr/bin/env bash
# Điều khiển lab. Chạy trên máy có Incus và OpenTofu (máy ảo Ubuntu trên Hyper-V hoặc Linux native).
# Dùng: lab {check|gen|ssh-ca|up|provision|seal|audit|down|destroy|status}
# Biến: LAB_PROFILE (mặc định compact), LAB_SSH_KEY, LAB_K3S_VERSION, LAB_K3S_SHA256 (ghim k3s, tự lấy từ trang phát hành)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
INFRA="$ROOT/infra"
PROFILE="${LAB_PROFILE:-compact}"
GEN="$INFRA/generated"
SSH_KEY="${LAB_SSH_KEY:-$(cat "$HOME/.ssh/id_ed25519.pub" 2>/dev/null || true)}"

tf() { tofu -chdir="$INFRA/tofu" "$@" -var "profile=$PROFILE" -var "ssh_public_key=$SSH_KEY" -var "generated_dir=$GEN"; }
# Thứ tự bật: Secret, Data, Internal, Perimeter, Edge (7.6, lab chỉ chạy khi bật).
UP_ORDER=(fw-1 bao-1 data-1 ch-1 kafka-1 k8s-cp-1 k8s-wk-1 k8s-wk-2 ops-1 bastion perimeter-1 dns-1 edge-1 origin dns-mock loadgen)

need() { command -v "$1" >/dev/null || { echo "thiếu $1"; exit 1; }; }

cmd_check() { python3 "$INFRA/tools/test_gen_nft.py" && python3 "$INFRA/tools/gen_nft.py" check "$PROFILE"; }

cmd_gen() { # gen [--bootstrap]
  python3 "$INFRA/tools/gen_nft.py" gen "$PROFILE" "$@" -o "$GEN/$PROFILE"
  python3 "$INFRA/tools/gen_lab.py" inventory "$PROFILE" -o "$GEN/$PROFILE/inventory"
  nft -c -f "$GEN/$PROFILE/ruleset.nft" 2>/dev/null || echo "(bỏ qua nft -c: không chạy được ở đây)"
}

cmd_ssh_ca() { # CA SSH của lab (P5 chuyển sang OpenBao ký)
  need ssh-keygen; mkdir -p "$GEN"
  [ -f "$GEN/ssh_user_ca" ] || ssh-keygen -q -t ed25519 -N "" -f "$GEN/ssh_user_ca" -C "lab-user-ca"
  chmod 600 "$GEN/ssh_user_ca"; echo "CA công khai: $GEN/ssh_user_ca.pub"
}

cmd_token() { [ -f "$GEN/k3s-token" ] || { umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$GEN/k3s-token"; }; }

ansible_run() { # ansible_run <playbook> [tham số]
  need ansible-playbook; cmd_ssh_ca; cmd_token
  ( cd "$ROOT/ansible" && ansible-galaxy collection install -r requirements.yml >/dev/null &&
    ansible-playbook -i "$GEN/$PROFILE/inventory" "$@" \
      -e "lab_generated_dir=$GEN" -e "k3s_version=${LAB_K3S_VERSION:-}" -e "k3s_sha256=${LAB_K3S_SHA256:-}" \
      -e "k3s_token=$(cat "$GEN/k3s-token")" )
}

cmd_provision() { ansible_run site.yml "$@"; }
cmd_audit() { ansible_run playbooks/audit.yml "$@"; }

cmd_up() {
  need tofu; need incus; [ -n "$SSH_KEY" ] || { echo "đặt LAB_SSH_KEY (khoá công khai)"; exit 1; }
  cmd_check
  if incus info fw-1 >/dev/null 2>&1; then
    # Lab đã dựng: chỉ bật lại theo thứ tự.
    for vm in "${UP_ORDER[@]}"; do incus info "$vm" >/dev/null 2>&1 && incus start "$vm" 2>/dev/null || true; done
    return
  fi
  cmd_gen --bootstrap
  tf init -input=false
  tf apply -input=false -auto-approve -target=incus_instance.fw   # fw-1 lên trước
  echo "chờ cloud-init của fw-1..."; incus exec fw-1 -- cloud-init status --wait
  tf apply -input=false -auto-approve
  echo "Lab đã dựng ở chế độ BOOTSTRAP (mọi vùng ra Internet để cài gói). Chạy 'lab provision' rồi 'lab seal'."
}

cmd_seal() { # gỡ đường ra Internet tạm, về đúng ma trận
  cmd_gen
  incus file push "$GEN/$PROFILE/ruleset.nft" fw-1/etc/nftables.conf
  incus exec fw-1 -- nft -f /etc/nftables.conf
  cmd_provision -e lab_bootstrap=false --tags packages,access,updates,kernel,hostfw   # khoá SSH tĩnh, apt qua egress, firewall máy chủ không còn bootstrap
  echo "đã seal: fw-1 chỉ còn luật trong ma trận"
}

cmd_down() { # snapshot rồi tắt theo thứ tự ngược
  local snap="down-$(date +%Y%m%d-%H%M%S)"
  for ((i=${#UP_ORDER[@]}-1; i>=0; i--)); do
    vm="${UP_ORDER[$i]}"
    incus info "$vm" >/dev/null 2>&1 || continue
    incus snapshot create "$vm" "$snap" 2>/dev/null || true
    incus stop "$vm" 2>/dev/null || true
  done
  echo "đã tắt, snapshot $snap"
}

cmd_destroy() { need tofu; tf destroy -input=false -auto-approve; }
cmd_status() { incus list -c ns4t -f compact; }

case "${1:-}" in
  check) cmd_check ;; gen) shift; cmd_gen "$@" ;; ssh-ca) cmd_ssh_ca ;; up) cmd_up ;;
  provision) shift; cmd_provision "$@" ;; audit) shift; cmd_audit "$@" ;; seal) cmd_seal ;;
  down) cmd_down ;; destroy) cmd_destroy ;; status) cmd_status ;;
  *) sed -n '2,4p' "$0"; exit 2 ;;
esac
