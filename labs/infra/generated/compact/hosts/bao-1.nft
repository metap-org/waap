#!/usr/sbin/nft -f
# Sinh tự động từ flows.yaml cho bao-1 (profile compact). KHÔNG sửa tay.
flush ruleset
table inet host {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept comment "stateful"
    ct state invalid drop
    iifname "lo" accept
    icmp type echo-request limit rate 5/second accept comment "ping"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } tcp dport { 8200 } accept comment "N19"
    ip saddr { 10.10.50.11 } tcp dport { 8200, 8201 } accept comment "N20"
    ip saddr { 10.10.60.11 } tcp dport { 22 } accept comment "N25"
    ip saddr { 10.10.60.12 } tcp dport { 9100, 9090 } accept comment "N26"
    counter drop comment "default-deny"
  }
  chain output {
    type filter hook output priority 0; policy accept;
  }
}
