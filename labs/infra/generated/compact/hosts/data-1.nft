#!/usr/sbin/nft -f
# Sinh tự động từ flows.yaml cho data-1 (profile compact). KHÔNG sửa tay.
flush ruleset
table inet host {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept comment "stateful"
    ct state invalid drop
    iifname "lo" accept
    icmp type echo-request limit rate 5/second accept comment "ping"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } tcp dport { 5432 } accept comment "N14"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } tcp dport { 5671 } accept comment "N15"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } tcp dport { 6379 } accept comment "N18"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } tcp dport { 443 } accept comment "N18o"
    ip saddr { 10.10.40.11 } tcp dport { 5432 } accept comment "N23"
    ip saddr { 10.10.60.11 } tcp dport { 22 } accept comment "N25"
    ip saddr { 10.10.60.12 } tcp dport { 9100, 9090 } accept comment "N26"
    counter drop comment "default-deny"
  }
  chain output {
    type filter hook output priority 0; policy accept;
  }
}
