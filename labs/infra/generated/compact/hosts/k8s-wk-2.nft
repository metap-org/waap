#!/usr/sbin/nft -f
# Sinh tự động từ flows.yaml cho k8s-wk-2 (profile compact). KHÔNG sửa tay.
flush ruleset
table inet host {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept comment "stateful"
    ct state invalid drop
    iifname "lo" accept
    icmp type echo-request limit rate 5/second accept comment "ping"
    ip saddr { 10.10.20.11 } tcp dport { 443 } accept comment "N04"
    ip saddr { 10.10.20.11 } tcp dport { 443 } accept comment "N09"
    ip saddr { 10.10.60.11 } tcp dport { 22 } accept comment "N25"
    ip saddr { 10.10.60.12 } tcp dport { 9100, 9090 } accept comment "N26"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } accept comment "L02 K8s nội vùng"
    counter drop comment "default-deny"
  }
  chain output {
    type filter hook output priority 0; policy accept;
  }
}
