#!/usr/sbin/nft -f
# Sinh tự động từ flows.yaml, profile compact. KHÔNG sửa tay.
flush ruleset
table inet lab {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept comment "stateful"
    iifname "lo" accept
    ip saddr { 10.10.60.11 } tcp dport 22 accept comment "N25 vào fw-1"
  }
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept comment "stateful"
    ct state invalid drop
    ip saddr { 10.10.0.11, 10.10.0.12, 10.10.0.13 } ip daddr { 10.10.20.11 } tcp dport { 443 } accept comment "N01"
    ip saddr { 10.10.0.11, 10.10.0.12, 10.10.0.13 } ip daddr { 10.10.10.11 } tcp dport { 80, 443 } accept comment "N02"
    ip saddr { 10.10.0.11, 10.10.0.12, 10.10.0.13 } ip daddr { 10.10.10.11 } udp dport { 443 } accept comment "N02q (N02)"
    ip saddr { 10.10.0.11, 10.10.0.12, 10.10.0.13 } ip daddr { 10.10.10.12 } udp dport { 53 } accept comment "N03"
    ip saddr { 10.10.0.11, 10.10.0.12, 10.10.0.13 } ip daddr { 10.10.10.12 } tcp dport { 53 } accept comment "N03t (N03)"
    ip saddr { 10.10.20.11 } ip daddr { 10.10.30.21, 10.10.30.22 } tcp dport { 443 } accept comment "N04"
    ip saddr { 10.10.10.11, 10.10.10.12 } ip daddr { 10.10.20.11 } tcp dport { 443 } accept comment "N05 (N05,N06,N07,N08)"
    ip saddr { 10.10.20.11 } ip daddr { 10.10.30.21, 10.10.30.22 } tcp dport { 443 } accept comment "N09"
    ip saddr { 10.10.10.11 } ip daddr { 10.10.0.11, 10.10.0.12, 10.10.0.13 } tcp dport { 80, 443 } accept comment "N12"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } ip daddr { 10.10.40.11 } tcp dport { 5432 } accept comment "N14"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } ip daddr { 10.10.40.11 } tcp dport { 5671 } accept comment "N15"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } ip daddr { 10.10.40.13 } tcp dport { 9093 } accept comment "N16"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } ip daddr { 10.10.40.12 } tcp dport { 8443, 9440 } accept comment "N17"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } ip daddr { 10.10.40.11 } tcp dport { 6379 } accept comment "N18"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } ip daddr { 10.10.40.11 } tcp dport { 443 } accept comment "N18o (N18)"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } ip daddr { 10.10.50.11 } tcp dport { 8200 } accept comment "N19"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } ip daddr { 10.10.20.11 } tcp dport { 3128 } accept comment "N21"
    ip saddr { 10.10.20.11 } oifname "uplink" tcp dport { 80, 443, 587 } accept comment "N22"
    ip saddr { 10.10.0.11, 10.10.0.12, 10.10.0.13 } ip daddr { 10.10.60.11 } udp dport { 51820 } accept comment "N24"
    ip saddr { 10.10.60.11 } ip daddr { 10.10.0.11, 10.10.0.12, 10.10.0.13, 10.10.10.11, 10.10.10.12, 10.10.20.11, 10.10.30.11, 10.10.30.21, 10.10.30.22, 10.10.40.11, 10.10.40.12, 10.10.40.13, 10.10.50.11 } tcp dport { 22 } accept comment "N25"
    ip saddr { 10.10.60.12 } ip daddr { 10.10.0.11, 10.10.0.12, 10.10.0.13, 10.10.10.11, 10.10.10.12, 10.10.20.11, 10.10.30.11, 10.10.30.21, 10.10.30.22, 10.10.40.11, 10.10.40.12, 10.10.40.13, 10.10.50.11 } tcp dport { 9100, 9090 } accept comment "N26"
    ip saddr { 10.10.20.11, 10.10.30.11, 10.10.30.21, 10.10.30.22, 10.10.40.11, 10.10.40.12, 10.10.40.13 } ip daddr { 10.10.60.12 } udp dport { 53, 123 } accept comment "N27"
    ip saddr { 10.10.30.11, 10.10.30.21, 10.10.30.22 } ip daddr { 10.10.60.12 } tcp dport { 443 } accept comment "N28"
    ip saddr { 10.10.60.12 } ip daddr { 10.10.20.11 } tcp dport { 3128 } accept comment "N29"
    ip saddr { 10.10.0.11, 10.10.0.12, 10.10.0.13 } oifname "uplink" tcp dport { 80, 443 } accept comment "L01 (lab)"
    ip saddr { 10.10.10.0/24, 10.10.20.0/24, 10.10.30.0/24, 10.10.40.0/24, 10.10.50.0/24, 10.10.60.0/24 } oifname "uplink" tcp dport { 53, 80, 443 } accept comment "BOOTSTRAP gỡ bằng lab seal"
    ip saddr { 10.10.10.0/24, 10.10.20.0/24, 10.10.30.0/24, 10.10.40.0/24, 10.10.50.0/24, 10.10.60.0/24 } oifname "uplink" udp dport { 53, 123 } accept comment "BOOTSTRAP gỡ bằng lab seal"
    counter drop comment "default-deny"
  }
}
table ip labnat {
  chain post {
    type nat hook postrouting priority 100; policy accept;
    oifname "uplink" masquerade
  }
}
