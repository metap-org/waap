---
# NodePort của telemetry: egw-1 chuyển tiếp POST /ingest/events tới đây (I04). Tạm, thay bằng ingress controller.
apiVersion: v1
kind: Service
metadata: { name: config-distributor, namespace: waap }
spec:
  type: NodePort
  selector: { app: config-distributor }
  ports: [{ port: 4100, targetPort: 4100, nodePort: 30410 }]
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: web, namespace: waap }
spec:
  replicas: 1
  selector: { matchLabels: { app: web } }
  template:
    metadata: { labels: { app: web } }
    spec:
      containers:
        - name: app
          image: waap/web:${TAG}
          imagePullPolicy: Never
          securityContext: { allowPrivilegeEscalation: false, capabilities: { drop: [ALL], add: [NET_BIND_SERVICE, CHOWN, SETUID, SETGID] } }
          ports: [{ containerPort: 80 }]
          readinessProbe: { httpGet: { path: /, port: 80 }, periodSeconds: 10 }
          resources: { requests: { cpu: 50m, memory: 32Mi }, limits: { memory: 128Mi } }
---
# NodePort của portal: ingress-1 chuyển tiếp tới đây (I03). Tạm, thay bằng ingress controller.
apiVersion: v1
kind: Service
metadata: { name: web, namespace: waap }
spec:
  type: NodePort
  selector: { app: web }
  ports: [{ port: 80, targetPort: 80, nodePort: 30080 }]
