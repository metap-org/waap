apiVersion: apps/v1
kind: Deployment
metadata: { name: graphql-gateway, namespace: waap }
spec:
  replicas: 1
  selector: { matchLabels: { app: graphql-gateway } }
  template:
    metadata: { labels: { app: graphql-gateway } }
    spec:
      securityContext: { runAsNonRoot: true, runAsUser: 65534, seccompProfile: { type: RuntimeDefault } }
      containers:
        - name: app
          image: waap/waf-graphql-gateway:${TAG}
          imagePullPolicy: Never
          securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
          ports: [{ containerPort: 4000 }]
          env:
            - { name: PORT, value: "4000" }
            - { name: UPSTREAM_1_NAME, value: zones }
            - { name: UPSTREAM_1_GRPC_ADDR, value: "zones-service:3001" }
            - { name: UPSTREAM_1_LOGIN_URL, value: "http://zones-service:3000/auth/login" }
            - { name: UPSTREAM_1_REST_URL, value: "http://zones-service:3000" }
            - { name: UPSTREAM_2_NAME, value: scanning }
            - { name: UPSTREAM_2_GRPC_ADDR, value: "scanning-service:3011" }
            - { name: UPSTREAM_2_LOGIN_URL, value: "http://zones-service:3000/auth/login" }
            - { name: UPSTREAM_2_REST_URL, value: "http://scanning-service:3010" }
            - { name: UPSTREAM_3_NAME, value: alerting }
            - { name: UPSTREAM_3_GRPC_ADDR, value: "alerting-service:3021" }
            - { name: UPSTREAM_3_LOGIN_URL, value: "http://zones-service:3000/auth/login" }
            - { name: UPSTREAM_3_REST_URL, value: "http://alerting-service:3020" }
            - name: UPSTREAM_1_SERVICE_EMAIL
              valueFrom: { secretKeyRef: { name: waap-secrets, key: service-email } }
            - name: UPSTREAM_1_SERVICE_PASSWORD
              valueFrom: { secretKeyRef: { name: waap-secrets, key: service-password } }
            - name: UPSTREAM_2_SERVICE_EMAIL
              valueFrom: { secretKeyRef: { name: waap-secrets, key: service-email } }
            - name: UPSTREAM_2_SERVICE_PASSWORD
              valueFrom: { secretKeyRef: { name: waap-secrets, key: service-password } }
            - name: UPSTREAM_3_SERVICE_EMAIL
              valueFrom: { secretKeyRef: { name: waap-secrets, key: service-email } }
            - name: UPSTREAM_3_SERVICE_PASSWORD
              valueFrom: { secretKeyRef: { name: waap-secrets, key: service-password } }
          envFrom: [{ configMapRef: { name: waap-config } }]
          readinessProbe: { tcpSocket: { port: 4000 }, periodSeconds: 5, failureThreshold: 12 }
          resources: { requests: { cpu: 100m, memory: 128Mi }, limits: { memory: 512Mi } }
---
apiVersion: v1
kind: Service
metadata: { name: graphql-gateway, namespace: waap }
spec: { selector: { app: graphql-gateway }, ports: [{ port: 4000 }] }
---
