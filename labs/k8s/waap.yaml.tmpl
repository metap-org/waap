          ports: [{ containerPort: 4100 }]
          env:
            - { name: PORT, value: "4100" }
            - name: CONTROL_SERVICE_EMAIL
              valueFrom: { secretKeyRef: { name: waap-secrets, key: control-email } }
            - name: CONTROL_SERVICE_PASSWORD
              valueFrom: { secretKeyRef: { name: waap-secrets, key: control-password } }
