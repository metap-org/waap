# Ứng dụng của Management, Control và Analytics trên k3s. Dựng bằng `lab deploy`: envsubst điền IP và tag, rồi kubectl apply.
# Bí mật nằm trong Secret `waap-secrets` do `lab deploy` tạo từ generated/secrets.yml (lab chỉ; P5 thay bằng OpenBao).
apiVersion: v1
kind: Namespace
metadata:
  name: waap
  labels:
    # web (nginx) chưa chạy được ở mức restricted; hạ xuống baseline, vẫn cảnh báo restricted cho các pod còn lại.
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: v1
kind: ConfigMap
metadata: { name: waap-config, namespace: waap }
data:
  JWKS_URL: http://zones-service:3000/.well-known/jwks.json
  GRPC_ENABLED: "true"
  SCANNING_GRPC_ADDR: scanning-service:3011
  ALERTING_GRPC_ADDR: alerting-service:3021
  DOH_RESOLVER_URL: http://${DNS_MOCK_IP}:8053/resolve
  ANALYTICS_URL: http://analytics-api:3030
  CLICKHOUSE_URL: clickhouse://default:@${CLICKHOUSE_IP}:9000
  ZONES_URL: http://graphql-gateway:4000
  CONTROL_LOGIN_URL: http://zones-service:3000/auth/login
  RESYNC_INTERVAL_SECONDS: "60"
  CORS_ORIGINS: https://${INGRESS_IP}
---
# zones-service: nơi duy nhất giữ khoá ký (JWKS issuer).
apiVersion: apps/v1
kind: Deployment
metadata: { name: zones-service, namespace: waap }
spec:
  replicas: 1
  selector: { matchLabels: { app: zones-service } }
  template:
    metadata: { labels: { app: zones-service } }
    spec:
      securityContext: { runAsNonRoot: true, runAsUser: 65534, seccompProfile: { type: RuntimeDefault } }
      containers:
        - name: app
          image: waap/zones-service:${TAG}
          imagePullPolicy: Never
          securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
          ports: [{ containerPort: 3000 }, { containerPort: 3001 }]
          env:
            - { name: PORT, value: "3000" }
            - { name: JWKS_KEYS_DIR, value: /app/keys/jwks }
            - name: DATABASE_URL
              valueFrom: { secretKeyRef: { name: waap-secrets, key: database-url } }
            - name: RABBITMQ_URL
              valueFrom: { secretKeyRef: { name: waap-secrets, key: amqp-url } }
          envFrom: [{ configMapRef: { name: waap-config } }]
          volumeMounts: [{ name: jwks, mountPath: /app/keys/jwks, readOnly: true }]
          readinessProbe: { httpGet: { path: /health, port: 3000 }, periodSeconds: 5, failureThreshold: 12 }
          resources: { requests: { cpu: 100m, memory: 128Mi }, limits: { memory: 512Mi } }
      volumes: [{ name: jwks, secret: { secretName: waap-jwks } }]
---
apiVersion: v1
kind: Service
metadata: { name: zones-service, namespace: waap }
spec: { selector: { app: zones-service }, ports: [{ name: http, port: 3000 }, { name: grpc, port: 3001 }] }
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: scanning-service, namespace: waap }
spec:
  replicas: 1
  selector: { matchLabels: { app: scanning-service } }
  template:
    metadata: { labels: { app: scanning-service } }
    spec:
      securityContext: { runAsNonRoot: true, runAsUser: 65534, seccompProfile: { type: RuntimeDefault } }
      containers:
        - name: app
          image: waap/scanning-service:${TAG}
          imagePullPolicy: Never
          securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
          ports: [{ containerPort: 3010 }, { containerPort: 3011 }]
          env:
            - { name: PORT, value: "3010" }
            - name: DATABASE_URL
              valueFrom: { secretKeyRef: { name: waap-secrets, key: database-url } }
            - name: RABBITMQ_URL
              valueFrom: { secretKeyRef: { name: waap-secrets, key: amqp-url } }
          envFrom: [{ configMapRef: { name: waap-config } }]
          readinessProbe: { httpGet: { path: /health, port: 3010 }, periodSeconds: 5, failureThreshold: 12 }
          resources: { requests: { cpu: 100m, memory: 128Mi }, limits: { memory: 512Mi } }
---
