# Optional overrides read by `docker-compose.yml`. Copy this file to `.env` next to it; docker
# compose auto-loads it.

# Account emails (invitations, password reset), read by management-service, the token issuer. Unset:
# no email is sent. Point these at a relay; PUBLIC_APP_URL is the portal origin the links open.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_APP_URL=

# Tenant credentials (Workspace > Credentials), read by every service that serves the admin API.
# Either or both. SECRETS_ENCRYPTION_KEYS: "id:base64key[,id:base64key]", each key 32 random bytes
# (`openssl rand -base64 32`); the first key seals new values, the others only open older ones
# (rotation: put the new key first, re-save credentials, then drop the old). Keep it out of the
# database and out of backups of it. VAULT_*: an external secret manager (AWS_SECRETS_REGION or
# GCP_SECRETS_PROJECT_ID work instead).
SECRETS_ENCRYPTION_KEYS=
VAULT_ADDR=
VAULT_TOKEN=
# The tenant (uuid) that runs this WAAP service. Its admin defines plans and gives customer tenants a
# subscription; its own workspace is never limited. Empty = no plan limits.
OPERATOR_TENANT_ID=
